# Server Network Settings
PORT=3000                 # Port number for Express server (Default: 3000)
HOST=0.0.0.0              # Network interface to bind to (Default: 0.0.0.0)

# Timezone Configuration
TZ_NAME=Asia/Kolkata      # IANA Timezone for 6 AM business day rollover & timestamps (Default: Asia/Kolkata)

# Local Storage & Backup Paths (optional overrides)
DB_PATH=                  # Absolute or relative path to SQLite DB file (Default: ./data.db)
BACKUP_DIR=               # Directory for automated and manual backup snapshots (Default: ./backups)

# Cloud SQL / PostgreSQL Sync (optional for cloud persistence)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=